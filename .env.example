# ---------------------------------------------------------------------------
# EBIM Control Plane — variables de entorno
# Copiar a `.env.local`. NUNCA versionar valores reales.
# ---------------------------------------------------------------------------

# URL del proyecto Supabase (local por defecto: `supabase status` -> API URL)
VITE_SUPABASE_URL=http://127.0.0.1:54421

# Clave PUBLICABLE / anon. Es pública por diseño: la seguridad la da RLS.
# NUNCA poner aquí la service_role key.
VITE_SUPABASE_ANON_KEY=<pegar el valor de `supabase status` -> anon key>

# Nombre del entorno mostrado en la UI (LOCAL | DEV | QAS | PRD)
VITE_APP_ENV=LOCAL

# ---------------------------------------------------------------------------
# SÓLO SERVIDOR — Edge Functions / scripts de operador.
# Estas NO llevan prefijo VITE_ y por tanto NUNCA llegan al bundle del browser.
# Se cargan como Supabase Edge Function secrets, no en este archivo.
# ---------------------------------------------------------------------------

# DRY_RUN (por defecto) | LIVE. LIVE exige autorización explícita del operador.
PROVISIONING_MODE=DRY_RUN

# Personal Access Token de la Supabase Management API. Sólo en secrets del
# servidor. Si está vacío, el provider LIVE se niega a arrancar.
# SUPABASE_MANAGEMENT_TOKEN=

# Habilita operaciones contra un proyecto remoto marcado como DEV.
EBIM_ALLOW_REMOTE_DEV=false
