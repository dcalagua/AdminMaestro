+    } catch (error) {
+      toast.error('No se pudo recalcular', businessErrorMessage(error));
+    }
+  }
+
+  async function doSuspend() {
+    try {
+      const result = (await suspend.mutateAsync({ p_mode: 'DRY_RUN' })) as {
+        applied?: number;
+        skipped?: number;
+      } | null;
+      toast.success(
