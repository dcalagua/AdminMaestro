+const AGGREGATE_KEYS = [
+  'dashboard-summary',
+  'product-margin',
+  'partner-margin',
+  'tenant-margin',
+  'audit-logs',
+];
+
+function useRpc<K extends keyof Fns & string>(fn: K, keys: string[]) {
+  const qc = useQueryClient();
+  return useMutation({
+    mutationFn: (args: Args<K>) => callRpc(fn, args),
+    onSuccess: () => invalidate(qc, [...keys, ...AGGREGATE_KEYS]),
+  });
+}
