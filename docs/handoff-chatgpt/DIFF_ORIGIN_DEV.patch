+      </div>
+
+      <div className="mb-4 grid gap-3 sm:grid-cols-3">
+        <StatCard
+          label="Vencidas"
+          value={formatNumber(all.filter((r) => r.is_past_due).length)}
+          tone="warn"
+        />
+        <StatCard
+          label="En gracia"
+          value={formatNumber(all.filter((r) => r.in_grace).length)}
+          tone="warn"
+        />
+        <StatCard
+          label="Suspensión pendiente"
