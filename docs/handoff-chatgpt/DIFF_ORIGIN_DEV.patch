+            <button
+              type="button"
+              className="ebim-btn-ghost"
+              onClick={() => void doRefresh()}
+              disabled={refresh.isPending}
+            >
+              {refresh.isPending ? 'Recalculando…' : 'Recalcular alertas'}
+            </button>
+            {perms.canManagePlatform ? (
+              <button
+                type="button"
+                className="ebim-btn-danger"
+                onClick={() => setConfirmSuspend(true)}
