+   ========================================================================== */
+
+const itemSchema = z
+  .object({
+    charge_kind: z.enum([
+      'LICENSE', 'PARTNER_BASE_LICENSE', 'TENANT_LICENSE', 'IMPLEMENTATION_FEE',
+      'INFRASTRUCTURE_FEE', 'SUPPORT_FEE', 'ADDON', 'PROFESSIONAL_SERVICES', 'DISCOUNT',
