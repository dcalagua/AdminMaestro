+              </FieldRow>
+
+              <TextField
+                label="Importe de la licencia" type="number" min={0} step="0.01"
+                placeholder={listedPrice !== null ? String(listedPrice) : 'Sin tarifa vigente'}
+                hint={
+                  listedPrice !== null
+                    ? `Vacío = tarifa vigente del plan (${formatMoney(listedPrice, values.currency)}).`
