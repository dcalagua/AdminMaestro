 select pg_temp.act_as('10000000-0000-4000-a000-000000000001');
 
 select is(
-  (select count(*)::int from platform.organizations), 10,
-  'SUPER_ADMIN ve las 10 organizaciones'
+  (select count(*)::int from platform.organizations),
